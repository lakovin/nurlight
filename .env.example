# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# База данных. Для разработки можно оставить SQLite:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://nurlight:nurlight@localhost:5432/nurlight

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Сайт для клиентов: контакты в подвале и кнопка бота (пусто — не показываются)
SHOP_PHONE=
SHOP_HOURS=
TELEGRAM_BOT_USERNAME=

# Оплата в боте (встроенные платежи Telegram, Stripe в тестовом режиме).
# Токен выдаёт @BotFather: Payments -> Stripe -> Connect Stripe Test.
# Пусто — оплата выключена, бот работает как раньше.
PAYMENT_PROVIDER_TOKEN=

# Демо-оплата БЕЗ списания денег (кнопка «Оплатить (тест)»), если токена выше нет.
# Только для показа на защите; там, где оформляют настоящие заказы, не включать.
PAYMENT_DEMO=
