# Настройки панели на https://nurlight-admin.moji.rest (визитка nurlight.moji.rest — отдельно, на Cloudflare)
# Скопируйте в deploy/public.env (в git не попадает) и заполните.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=сгенерируйте-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=nurlight-admin.moji.rest,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://nurlight-admin.moji.rest

# Отдельная база от разработки: без демо-пользователей
DATABASE_URL=sqlite:///prod.sqlite3
# 1 — быстрый режим: соединение с базой держится открытым. Переключать: ./deploy/db_mode.sh on|off
DB_PERSISTENT=0

# Токен бота. Пустой — запустится только панель.
# Один токен нельзя запускать в двух местах сразу: остановите бота у себя, если он работает здесь.
BOT_TOKEN=

# Имя туннеля Cloudflare
TUNNEL_NAME=nurlight
PANEL_PORT=8001

# Сайт для клиентов: контакты в подвале и кнопка бота (пусто — не показываются)
SHOP_PHONE=
SHOP_HOURS=
TELEGRAM_BOT_USERNAME=
