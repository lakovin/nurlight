# Настройки для запуска на https://nurlight.moji.rest
# Скопируйте в deploy/public.env (в git не попадает) и заполните.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=сгенерируйте-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=nurlight.moji.rest,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://nurlight.moji.rest

# Отдельная база от разработки: без демо-пользователей
DATABASE_URL=sqlite:///prod.sqlite3

# Токен бота. Пустой — запустится только панель.
# Один токен нельзя запускать в двух местах сразу: остановите бота у себя, если он работает здесь.
BOT_TOKEN=

# Имя туннеля Cloudflare
TUNNEL_NAME=nurlight
PANEL_PORT=8001
